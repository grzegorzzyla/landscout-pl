# LandScout PL — zmienne dla docker-compose.yml
#
# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore — NIGDY nie trafia do repozytorium.
# W Portainerze: Stacks → Add stack → sekcja Environment variables → "Load variables from .env file".

# --- gdzie leżą dane na NAS-ie -----------------------------------------------
# Katalog nadrzędny. Muszą w nim istnieć podkatalogi:
#   properties/  claude-home/  cache/  fb-profile/  tailscale/
DATA_ROOT=/volume1/docker/landscout

# Właściciel tych katalogów — sprawdź na NAS-ie poleceniem: id
# Bez tego pliki tworzone przez kontener będą miały obcego właściciela.
PUID=1000
PGID=1000

TZ=Europe/Warsaw

# --- dostęp do strony ---------------------------------------------------------
# Hasło do bramki logowania (wspólne dla wszystkich urządzeń).
ACCESS_PASSWORD=zmien-mnie

# Sekret do podpisywania sesji. Wygeneruj własny:  openssl rand -hex 32
SESSION_SECRET=zmien-mnie-na-64-znaki-szesnastkowe

# UWAGA: ta zmienna dotyczy TYLKO serwera deweloperskiego (vite.server.allowedHosts przy
# `npm run dev` / `npm run start` na własnym komputerze). Kontener uruchamia zbudowany serwer
# (node dist/server/entry.mjs), który nagłówka Host nie sprawdza — tutaj możesz ją zostawić pustą.
# Przy pracy lokalnej podaj domenę tailnetu, np. .tailb4dbbf.ts.net (kropka na początku = subdomeny).
ALLOWED_HOSTS=

# --- Tailscale ----------------------------------------------------------------
# Klucz jednorazowy: panel Tailscale → Settings → Keys → Generate auth key.
# Warto zaznaczyć "Reusable" i "Ephemeral: off", żeby przeżył restart kontenera.
TS_AUTHKEY=tskey-auth-wstaw-swoj

# Nazwa maszyny widoczna w tailnecie.
TS_HOSTNAME=nas-landscout

# Podsieć LAN udostępniana w tailnecie — dzięki temu z telefonu widzisz CAŁY NAS
# i resztę sieci domowej, nie tylko ten kontener.
# Sprawdź swoją: ip route | grep -v default    (albo adres NAS-a z maską /24)
TS_ROUTES=192.168.2.0/24

# --accept-dns=false, żeby kontener nie przejmował DNS-a NAS-a.
TS_EXTRA_ARGS=--accept-dns=false
