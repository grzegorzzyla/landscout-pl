# Skopiuj do site/.env i uzupełnij. Plik .env jest w .gitignore — nigdy nie trafia do repo.

# Hasło dostępu do strony (prosta bramka na wspólne hasło).
# Puste = strona logowania pokaże ostrzeżenie, że hasło nie jest ustawione.
ACCESS_PASSWORD=

# Sekret do podpisywania sesji (HMAC-SHA256). Wygeneruj losowy, np.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Katalog główny projektu (używany przez backend do uruchamiania skryptów i Claude Code).
# Domyślnie wykrywany automatycznie — ustaw tylko, gdy uruchamiasz stronę spoza repo.
# ASSISTANT_DIR=c:\projects\landscout-pl

# Ścieżka do binarki Claude Code (opcjonalna — domyślnie wykrywana przez bin/cdp --which).
# CLAUDE_EXE=

# Dodatkowe hosty dopuszczone przez dev-serwer Vite (po przecinku), np. domena tailnetu
# Tailscale dla dostępu z telefonu: ALLOWED_HOSTS=.tail1234.ts.net
# ALLOWED_HOSTS=
