---
export const prerender = false;
import { passwordConfigured } from '../server/auth';
const configured = passwordConfigured();
const err = Astro.url.searchParams.has('e');
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Logowanie — Działki</title>
    <style>
      body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
        background: #0f1115; color: #e7e9ee; font: 15px/1.5 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
      .card { background: #181b22; border: 1px solid #2a2f3a; border-radius: 16px; padding: 32px;
        width: min(380px, 92vw); text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,.4); }
      h1 { margin: 0 0 6px; font-size: 22px; }
      p { color: #9aa3b2; margin: 0 0 22px; }
      form { display: flex; flex-direction: column; gap: 12px; }
      input { background: #1f232c; color: #e7e9ee; border: 1px solid #2a2f3a; border-radius: 10px;
        padding: 11px 14px; font-size: 15px; text-align: center; }
      input:focus { outline: none; border-color: #4f9cf9; }
      button { background: #4f9cf9; color: #06101f; border: none; border-radius: 10px; padding: 11px 14px;
        font-size: 15px; font-weight: 700; cursor: pointer; }
      .err { color: #e0574a; margin: 0 0 14px; }
      .warn { color: #e0a64a; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>🌱 Działki</h1>
      <p>Strona prywatna — podaj hasło dostępu.</p>
      {err && <p class="err">Błędne hasło — spróbuj ponownie.</p>}
      {configured ? (
        <form method="POST" action="/api/auth/login" id="login-form">
          <input type="password" name="password" placeholder="hasło" autofocus autocomplete="current-password" />
          <button type="submit">Wejdź</button>
          <p class="err" id="login-err" hidden>Błędne hasło — spróbuj ponownie.</p>
        </form>
        <script is:inline>
          // Wysyłamy JSON-em zamiast natywnym POST-em formularza: ochrona CSRF Astro odrzuca
          // formularze, gdy Origin nie zgadza się z Host (tak bywa za mapowaniem portów w Dockerze).
          // Atrybuty action/method zostają jako zapas dla przeglądarki bez JS.
          document.getElementById('login-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const input = e.target.querySelector('input[name=password]');
            const err = document.getElementById('login-err');
            err.hidden = true;
            try {
              const r = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ password: input.value }),
              });
              if (r.ok) { location.href = '/'; return; }
            } catch (_) { /* sieć padła — pokaż ten sam komunikat */ }
            err.hidden = false;
            input.value = '';
            input.focus();
          });
        </script>
      ) : (
        <p class="warn">Hasło nie jest jeszcze ustawione (brak ACCESS_PASSWORD w&nbsp;.env).</p>
      )}
    </div>
  </body>
</html>
