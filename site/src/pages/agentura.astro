---
export const prerender = false;
import Base from '../layouts/Base.astro';
---

<Base title="Agentura">
  <header>
    <a class="iconbtn" href="/" aria-label="Powrót do listy">←</a>
    <h1>⚙️ Agentura</h1>
    <button class="btn ghost" id="refresh" type="button">Odśwież</button>
  </header>

  <main class="agent-main">
    <section class="panel">
      <h3>Stan</h3>
      <p class="muted" id="auth-source">sprawdzanie…</p>
      <div id="checks" class="checks">
        <p class="muted">Kontrole uruchamiają realne procesy (m.in. start Chromium) — to potrwa kilkanaście sekund.</p>
      </div>
    </section>

    <section class="panel">
      <h3>Kolejka zadań</h3>
      <p class="muted">
        Zadanie czeka na swój termin i wykonuje się <strong>pojedynczo</strong> — agentura jest
        ciężka, więc dwa naraz tylko by sobie przeszkadzały. Nocny termin ma sens praktyczny:
        ocena ofert zużywa najwięcej tokenów, a limit dzielisz z sesjami w edytorze.
      </p>
      <div class="row" style="gap:8px; align-items:stretch; flex-wrap:wrap;">
        <select id="q-kind" style="flex:0 0 auto;">
          <option value="search">🔎 Odśwież wg kryteriów</option>
          <option value="fb-scan">📘 Skanuj grupy FB</option>
        </select>
        <input id="q-note" placeholder="uwagi, np. „tylko Podlasie, do 4 zł/m²" (opcjonalnie)" style="flex:1; min-width:220px;" />
        <button class="btn" id="q-night" type="button">Zleć na noc</button>
        <button class="btn ghost" id="q-now" type="button">Uruchom teraz</button>
      </div>
      <p class="muted" id="q-msg" hidden></p>
      <div id="q-list" class="checks" style="margin-top:10px;"></div>
    </section>

    <section class="panel" id="log-panel" hidden>
      <h3>Dziennik zadania <button class="btn ghost" id="log-close" type="button">zamknij</button></h3>
      <pre id="log-text" class="joblog"></pre>
    </section>

    <section class="panel">
      <h3>Powiadomienia</h3>
      <p class="muted">
        Wysyłane po zakończeniu zadania z kolejki. Konfiguracja przez zmienne w Portainerze —
        nieustawione kanały są pomijane. Uwaga o ntfy: publiczne <code>ntfy.sh</code> działa zza
        NAT-u, bo NAS tylko wysyła; własną instancję warto wystawić w tailnecie.
      </p>
      <div id="notif" class="checks"></div>
      <button class="btn ghost" id="notif-test" type="button" style="margin-top:8px;">Wyślij próbne</button>
      <p class="muted" id="notif-msg" hidden></p>
    </section>

    <section class="panel">
      <h3>Token Claude Code</h3>
      <p class="muted">
        Agentura działa na Twojej subskrypcji. Gdy token wygaśnie, wygeneruj nowy na swoim
        komputerze poleceniem <code>claude setup-token</code> i wklej poniżej — bez przebudowy
        kontenera i bez edycji zmiennych w Portainerze.
      </p>
      <div class="row" style="gap:8px; align-items:stretch;">
        <input type="password" id="token" placeholder="wklej token…" autocomplete="off" style="flex:1;" />
        <button class="btn" id="save-token" type="button">Zapisz</button>
        <button class="btn ghost" id="clear-token" type="button">Usuń</button>
      </div>
      <p class="muted" id="token-msg" hidden></p>
      <p class="muted">
        Token zapisuje się na wolumenie z prawami 0600 i ma pierwszeństwo przed zmienną
        <code>CLAUDE_CODE_OAUTH_TOKEN</code>. Nigdy nie jest odsyłany z powrotem do przeglądarki.
      </p>
    </section>
  </main>

  <Fragment slot="scripts">
    <script is:inline>
      const checksEl = document.getElementById('checks');
      const srcEl = document.getElementById('auth-source');
      const msg = document.getElementById('token-msg');

      function showMsg(text, ok) {
        msg.hidden = false;
        msg.textContent = (ok ? '✓ ' : '⚠ ') + text;
        msg.style.color = ok ? 'var(--good)' : 'var(--bad)';
      }

      async function load() {
        checksEl.innerHTML = '<p class="muted">Sprawdzanie… (start Chromium trwa najdłużej)</p>';
        srcEl.textContent = 'sprawdzanie…';
        try {
          const r = await fetch('/api/agent/status');
          const d = await r.json();
          srcEl.textContent = 'Autoryzacja: ' + d.authSource;
          checksEl.innerHTML = '';
          for (const c of d.checks) {
            const row = document.createElement('div');
            row.className = 'check ' + (c.ok ? 'ok' : 'bad');
            const name = document.createElement('strong');
            name.textContent = (c.ok ? '✓ ' : '✗ ') + c.name;
            const detail = document.createElement('span');
            detail.textContent = c.detail;
            row.appendChild(name);
            row.appendChild(detail);
            checksEl.appendChild(row);
          }
        } catch (e) {
          checksEl.innerHTML = '<p class="muted">Nie udało się pobrać stanu: ' + e.message + '</p>';
        }
      }

      document.getElementById('refresh').addEventListener('click', load);

      document.getElementById('save-token').addEventListener('click', async () => {
        const el = document.getElementById('token');
        const token = el.value.trim();
        if (!token) return showMsg('Wklej token', false);
        const r = await fetch('/api/agent/token', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token }),
        });
        const d = await r.json().catch(() => ({}));
        el.value = '';
        if (d.ok) { showMsg('Token zapisany — źródło: ' + d.source, true); load(); }
        else showMsg(d.error || 'Nie udało się zapisać', false);
      });

      document.getElementById('clear-token').addEventListener('click', async () => {
        const r = await fetch('/api/agent/token', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ action: 'clear' }),
        });
        const d = await r.json().catch(() => ({}));
        showMsg(d.ok ? 'Token usunięty — źródło: ' + d.source : 'Nie udało się usunąć', !!d.ok);
        load();
      });

      // --- kolejka ---------------------------------------------------------
      const qMsg = document.getElementById('q-msg');
      const qList = document.getElementById('q-list');

      const fmt = (ts) => ts ? new Date(ts).toLocaleString('pl-PL', { dateStyle:'short', timeStyle:'short' }) : '—';
      const LABEL = { queued:'⏳ w kolejce', running:'▶ wykonuje się', done:'✓ gotowe',
                      error:'✗ błąd', cancelled:'⊘ anulowane' };

      async function loadQueue() {
        try {
          const r = await fetch('/api/queue');
          const d = await r.json();
          qList.innerHTML = '';
          if (!d.tasks.length) {
            qList.innerHTML = '<p class="muted">Kolejka pusta.</p>';
          }
          for (const t of d.tasks) {
            const row = document.createElement('div');
            row.className = 'check ' + (t.status === 'error' ? 'bad' : t.status === 'done' ? 'ok' : '');
            const head = document.createElement('strong');
            head.textContent = LABEL[t.status] + ' · ' +
              (t.kind === 'search' ? 'wyszukiwanie' : 'skan FB') +
              (t.note ? ' · „' + t.note + '"' : '');
            const det = document.createElement('span');
            det.textContent = (t.status === 'queued' ? 'start: ' + fmt(t.runAt)
                              : 'start: ' + fmt(t.startedAt) + (t.finishedAt ? ' · koniec: ' + fmt(t.finishedAt) : ''))
                              + (t.summary ? ' · ' + t.summary : '')
                              + (t.error ? ' · ' + t.error : '');
            row.appendChild(head); row.appendChild(det);

            const actions = document.createElement('div');
            actions.style.marginTop = '4px';
            const logBtn = document.createElement('button');
            logBtn.className = 'btn ghost'; logBtn.type = 'button'; logBtn.textContent = 'dziennik';
            logBtn.addEventListener('click', () => showLog(t.id));
            actions.appendChild(logBtn);
            if (t.status === 'queued') {
              const cancelBtn = document.createElement('button');
              cancelBtn.className = 'btn ghost'; cancelBtn.type = 'button'; cancelBtn.textContent = 'anuluj';
              cancelBtn.style.marginLeft = '6px';
              cancelBtn.addEventListener('click', async () => {
                await fetch('/api/queue', { method:'POST', headers:{'content-type':'application/json'},
                  body: JSON.stringify({ cancelId: t.id }) });
                loadQueue();
              });
              actions.appendChild(cancelBtn);
            }
            row.appendChild(actions);
            qList.appendChild(row);
          }
        } catch (e) {
          qList.innerHTML = '<p class="muted">Nie udało się pobrać kolejki: ' + e.message + '</p>';
        }
      }

      async function showLog(id) {
        const panel = document.getElementById('log-panel');
        const pre = document.getElementById('log-text');
        panel.hidden = false;
        pre.textContent = 'wczytywanie…';
        const r = await fetch('/api/queue/log?id=' + encodeURIComponent(id));
        const d = await r.json();
        pre.textContent = d.ok ? d.log : (d.error || 'brak dziennika');
        pre.scrollTop = pre.scrollHeight;
        panel.scrollIntoView({ behavior:'smooth', block:'nearest' });
      }
      document.getElementById('log-close').addEventListener('click', () => {
        document.getElementById('log-panel').hidden = true;
      });

      async function addTask(when) {
        const kind = document.getElementById('q-kind').value;
        const note = document.getElementById('q-note').value;
        const r = await fetch('/api/queue', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ kind, note, when }),
        });
        const d = await r.json().catch(() => ({}));
        qMsg.hidden = false;
        qMsg.textContent = d.ok
          ? (when === 'now' ? '✓ Uruchomione teraz' : '✓ Zlecone na ' + fmt(d.task.runAt))
          : '⚠ Nie udało się dodać zadania';
        document.getElementById('q-note').value = '';
        loadQueue();
      }
      document.getElementById('q-night').addEventListener('click', () => addTask('night'));
      document.getElementById('q-now').addEventListener('click', () => addTask('now'));

      // --- powiadomienia ---------------------------------------------------
      async function loadNotif() {
        const el = document.getElementById('notif');
        try {
          const d = await (await fetch('/api/notify/test')).json();
          el.innerHTML = '';
          for (const c of d.channels) {
            const row = document.createElement('div');
            row.className = 'check ' + (c.configured ? 'ok' : '');
            const n = document.createElement('strong');
            n.textContent = (c.configured ? '✓ ' : '· ') + c.name;
            const s2 = document.createElement('span');
            s2.textContent = c.configured ? 'skonfigurowany' : 'nieskonfigurowany';
            row.appendChild(n); row.appendChild(s2);
            el.appendChild(row);
          }
        } catch (e) { el.textContent = 'Nie udało się sprawdzić: ' + e.message; }
      }
      document.getElementById('notif-test').addEventListener('click', async () => {
        const m = document.getElementById('notif-msg');
        m.hidden = false; m.textContent = 'wysyłanie…';
        const d = await (await fetch('/api/notify/test', { method: 'POST' })).json().catch(() => ({}));
        m.textContent = d.ok ? ('✓ wysłane: ' + d.sent.join(', ')) : ('⚠ ' + (d.error || 'błąd'));
        m.style.color = d.ok ? 'var(--good)' : 'var(--bad)';
      });
      loadNotif();

      loadQueue();
      setInterval(loadQueue, 15000);   // odświeżanie statusu w trakcie wykonywania
      load();
    </script>
  </Fragment>
</Base>
